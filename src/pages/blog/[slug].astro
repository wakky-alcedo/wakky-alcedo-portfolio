---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date, tags } = post.data;
const { Content } = await render(post);
const formattedDate = date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="page-main">
    <article class="blog-article">
      <header class="blog-article__header">
        <ul class="blog-article__tags">
          {tags.map(tag => <li class="blog-article__tag">{tag}</li>)}
        </ul>
        <h1 class="blog-article__title">{title}</h1>
        <time class="blog-article__date" datetime={date.toISOString()}>{formattedDate}</time>
      </header>
      <div class="prose">
        <Content />
      </div>
      <a href="/blog" class="back-link">← Blog 一覧に戻る</a>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
.page-main { padding-top: 64px; min-height: 100vh; }

.blog-article {
  max-width: 800px;
  margin: 0 auto;
  padding: 4rem 2rem;
}

.blog-article__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
  list-style: none;
  margin-bottom: 1rem;
}

.blog-article__tag {
  font-size: 0.75rem;
  padding: 0.125rem 0.6rem;
  background: rgba(255, 161, 0, 0.15);
  border: 1px solid rgba(255, 161, 0, 0.3);
  border-radius: 100px;
  color: var(--color-accent);
}

.blog-article__title {
  font-size: clamp(1.5rem, 4vw, 2.5rem);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 0.5rem;
}

.blog-article__date {
  font-size: 0.85rem;
  color: var(--color-text);
  opacity: 0.5;
}

.prose {
  margin-top: 2rem;
  color: var(--color-text);
  opacity: 0.9;
  line-height: 1.8;
}

.prose :global(h2) { font-size: 1.4rem; font-weight: 700; margin: 2rem 0 0.75rem; color: var(--color-secondary); }
.prose :global(h3) { font-size: 1.1rem; font-weight: 600; margin: 1.5rem 0 0.5rem; }
.prose :global(p)  { margin-bottom: 1rem; }
.prose :global(ul), .prose :global(ol) { padding-left: 1.5rem; margin-bottom: 1rem; }
.prose :global(li) { margin-bottom: 0.25rem; }

.back-link {
  display: inline-block;
  margin-top: 3rem;
  color: var(--color-secondary);
  opacity: 0.8;
  font-size: 0.9rem;
  transition: opacity 0.2s;
}

.back-link:hover { opacity: 1; }
</style>
