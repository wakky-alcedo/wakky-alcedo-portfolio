---
import PageLayout from '../../components/layout/PageLayout.astro';
import { getVisibleEntries } from '../../lib/collections';
import CardCollection from '../../components/common/CardCollection.astro';
import EntryCard from '../../components/common/EntryCard.astro';

const posts = (await getVisibleEntries('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<PageLayout title="Blog" description="活動記録・思考メモ一覧" subtitle="活動記録・思考メモ" width="wide">
  <CardCollection mobile="grid">
    {posts.map((post) => <EntryCard entry={post} />)}
  </CardCollection>
</PageLayout>
