---
import { Image } from 'astro:assets';
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SectionTitle from '../components/common/SectionTitle.astro';
import BackButton from '../components/common/BackButton.astro';
import profilePicture from '../assets/images/profile_picture.jpg';
import wakkyAlcedoIcon from '../assets/images/wakky_alcedo_icon.jpg';

const timeline = [
  { date: '2024/03', event: '群馬工業高等専門学校 機械工学科 卒業' },
  { date: '2024/04', event: '東京工業大学（現・東京科学大学）工学院機械系 編入学' },
  { date: '2026/03', event: '東京科学大学 卒業' },
  { date: '2026/04', event: '東京科学大学 工学院機械系 エンジニアリングデザインコース 入学' },
];

const certifications = [
  '普通自動車第一種運転免許',
  '第三級アマチュア無線技士',
];

const links = [
  { label: 'Twitter / X', value: '@wakky_alcedo', href: 'https://twitter.com/wakky_alcedo' },
  { label: 'Instagram', value: '@taku.t_0716', href: 'https://www.instagram.com/taku.t_0716/' },
  { label: 'GitHub', value: 'github.com/wakky-alcedo', href: 'https://github.com/wakky-alcedo' },
  { label: 'note', value: 'note.com/wakkyalcedo', href: 'https://note.com/wakkyalcedo' },
  { label: 'Qiita', value: 'qiita.com/wakky-alcedo', href: 'https://qiita.com/wakky-alcedo' },
  { label: '大学の所属研究室', value: 'Science Tokyo SDDL', href: 'http://www.sddl.mech.e.titech.ac.jp' },
];

const emailEncoded = 'd2Fra3kuYWxjZWRvQGdtYWlsLmNvbQ==';
---

<BaseLayout title="About" description="Wakky-Alcedo のプロフィール">
  <Header />
  <main class="page-main">
    <div class="page-container">
      <BackButton href="/" label="トップへ戻る" />
      <SectionTitle title="About" subtitle="自己紹介" />

      <div class="about-profile">
        <div class="about-profile__identity">
          <div class="about-profile__photo-wrap">
            <Image
              src={profilePicture}
              alt="プロフィール写真"
              width={200}
              height={200}
              class="about-profile__photo about-profile__photo--default"
            />
            <Image
              src={wakkyAlcedoIcon}
              alt="Wakky Alcedo アイコン"
              width={200}
              height={200}
              class="about-profile__photo about-profile__photo--hover"
            />
          </div>
          <h2 class="about-profile__name">
            <span class="about-profile__name-text about-profile__name-text--default">立脇 拓</span>
            <span class="about-profile__name-text about-profile__name-text--hover">Wakky Alcedo</span>
          </h2>
        </div>

        <div class="about-profile__bio">
          <p>小中，高専，大学と，一貫してものづくりをやってきました．手を動かして何かを作ることと，イベントの企画運営が好きです。発明考案展出展，高専ロボコン，全国ロボコン交流会幹事，商品開発インターン，受託開発アルバイト，画像認識&ロボット制御インターン，文化祭の企画・製作・運営などをしてきました。</p>

          <div class="about-bio__quote">
            <p class="about-bio__quote-title">「とりあえずポチる」</p>
            <p>あのとき挑戦しておけばよかったという後悔はしたくないと思い，フットワーク軽く生きています。九州-群馬100km自転車旅をしたり，トライアスロンに参加したり，etc.</p>
            <ul>
              <li><a href="https://www.instagram.com/stories/highlights/18061523467329284/" target="_blank" rel="noopener noreferrer">九州-群馬自転車旅の様子(Instagramに飛びます)</a></li>
              <li><a href="https://note.com/wakkyalcedo/n/n3cac58ecbdc4" target="_blank" rel="noopener noreferrer">トライアスロン参戦記</a></li>
            </ul>
          </div>

          <div class="about-bio__quote">
            <p class="about-bio__quote-title">「不満があるなら，自分で作ればいいじゃない」</p>
            <p>例えば，</p>
            <ul>
              <li>照明やエアコンの自動化</li>
              <li>自分用アプリ（ToDo管理，習慣管理，PC使用時間可視化）の開発</li>
              <li>3Dプリンタによる蛇口のノブや靴棚の自作</li>
            </ul>
            <p>など，身の回りの自動化や便利グッズの自作をやっています。また，大学の学園祭で，子どもたち向けのリズムゲームやロボット体験企画を主催しています。子どもたちが，すごく楽しそうにいきいきと遊んでくれるのを見ると，企画してよかったなと思います。</p>
          </div>
        </div>
      </div>

      <section class="about-section">
        <h2 class="about-section__title">Skills</h2>
        <div class="skills-detail">
          <div class="skills-detail__group">
            <h3 class="skills-detail__heading">組み込み制御</h3>
            <p class="skills-detail__intro">メインスキルです。</p>
            <ul>
              <li><strong>STM32</strong>（CubeIDE or VSCode PlatformIO）：ロボコンや高専文化祭にて，STM32のCubeIDEを用いた組み込み制御を担当</li>
              <li><strong>ESP32</strong>（VSCode PlatformIO、Arduinoベース）：趣味のIoT機器開発、およびアルバイト先で使用</li>
              <li><strong>Raspberry Pi</strong>：趣味のIoT機器開発などで使用</li>
              <li><strong>ROS2</strong>：アルバイトで7か月ほど使っていました。</li>
            </ul>
          </div>

          <div class="skills-detail__group">
            <h3 class="skills-detail__heading">機械設計等</h3>
            <p class="skills-detail__intro">機械専攻なのと，趣味で色々作っているので，一通りはできます。</p>
            <ul>
              <li>2DCAD: <strong>jw_cad</strong>（約5年）</li>
              <li>3DCAD: <strong>SOLIDWORKS</strong>（約8年），<strong>Fusion360</strong>（約1年），<strong>Inventor</strong>（約1年）</li>
              <li>my <strong>3Dプリンタ</strong>: Artillery Sidewinder-X1(2020購入), Bambu Lab A1 mini(2025購入)</li>
            </ul>
          </div>

          <div class="skills-detail__group">
            <h3 class="skills-detail__heading">プログラム言語</h3>
            <ul>
              <li><strong>C/C++</strong>：メイン言語，組み込みなどで8年くらいの付き合いです</li>
              <li><strong>Python</strong>：たまに...</li>
              <li>その他，Matlab，Excel VBA，GoogleAppScriptなど経験あり</li>
            </ul>
          </div>

          <div class="skills-detail__group">
            <h3 class="skills-detail__heading">その他</h3>
            <ul>
              <li><strong>YOLO</strong>：アルバイトで7か月ほどやっていました。</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="about-section">
        <h2 class="about-section__title">Timeline</h2>
        <ol class="timeline">
          {timeline.map(item => (
            <li class="timeline__item">
              <span class="timeline__year">{item.date}</span>
              <span class="timeline__event">{item.event}</span>
            </li>
          ))}
        </ol>

        <div class="about-section__sub">
          <h3 class="about-section__sub-title">Certification</h3>
          <ul class="certification-list">
            {certifications.map(cert => (
              <li>{cert}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="about-section">
        <h2 class="about-section__title">Link</h2>
        <ul class="link-list">
          <li class="link-list__item">
            <span class="link-list__label">Email</span>
            <button
              class="link-list__email"
              id="about-reveal-email"
              data-email={emailEncoded}
              aria-label="メールアドレスを表示"
            >クリックして表示</button>
          </li>
          {links.map(link => (
            <li class="link-list__item">
              <span class="link-list__label">{link.label}</span>
              <a href={link.href} target="_blank" rel="noopener noreferrer">{link.value}</a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const btn = document.getElementById('about-reveal-email') as HTMLButtonElement | null;
  if (btn) {
    btn.addEventListener('click', () => {
      const decoded = atob(btn.dataset.email ?? '');
      const link = document.createElement('a');
      link.href = `mailto:${decoded}`;
      link.textContent = decoded;
      btn.replaceWith(link);
    });
  }
</script>

<style>
.page-main { padding-top: 80px; min-height: 100vh; }
.page-container { max-width: 800px; margin: 0 auto; padding: 4rem 2rem; }

.about-profile {
  display: flex;
  gap: 2rem;
  align-items: flex-start;
  margin-bottom: 3rem;
}

.about-profile__identity {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}

.about-profile__photo-wrap {
  position: relative;
  width: 200px;
  height: 200px;
}

.about-profile__photo {
  position: absolute;
  inset: 0;
  width: 200px;
  height: 200px;
  border-radius: 50%;
  border: 3px solid var(--color-secondary);
  object-fit: cover;
  transition: opacity 0.3s ease;
}

.about-profile__photo--hover {
  opacity: 0;
}

.about-profile__identity:hover .about-profile__photo--default {
  opacity: 0;
}

.about-profile__identity:hover .about-profile__photo--hover {
  opacity: 1;
}

.about-profile__name {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--color-secondary);
}

.about-profile__name-text--hover {
  display: none;
}

.about-profile__identity:hover .about-profile__name-text--default {
  display: none;
}

.about-profile__identity:hover .about-profile__name-text--hover {
  display: inline;
}

.about-profile__bio p {
  color: var(--color-text);
  opacity: 0.85;
  line-height: 1.8;
  margin-bottom: 0.75rem;
}

.about-bio__quote {
  margin: 1.25rem 0;
  padding: 1rem 1.25rem;
  background: rgba(0, 99, 170, 0.1);
  border: 1px solid rgba(104, 206, 214, 0.2);
  border-radius: 10px;
}

.about-bio__quote-title {
  font-weight: 700;
  color: var(--color-accent);
}

.about-bio__quote ul {
  color: var(--color-text);
  opacity: 0.85;
  line-height: 1.8;
  padding-left: 1.5rem;
  margin-bottom: 0.75rem;
}

.about-bio__quote a {
  color: var(--color-secondary);
}

.about-section {
  margin-bottom: 3rem;
}

.about-section__title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: 1.25rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(104, 206, 214, 0.2);
}

.skills-detail__group {
  margin-bottom: 1.5rem;
}

.skills-detail__heading {
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-accent);
  margin-bottom: 0.5rem;
}

.skills-detail__intro,
.skills-detail__group ul {
  color: var(--color-text);
  opacity: 0.85;
  line-height: 1.8;
}

.skills-detail__group ul {
  padding-left: 1.5rem;
}

.timeline {
  list-style: none;
  border-left: 2px solid rgba(104, 206, 214, 0.3);
  padding-left: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.timeline__item {
  position: relative;
  display: flex;
  gap: 1.5rem;
  align-items: baseline;
}

.timeline__item::before {
  content: '';
  position: absolute;
  left: -1.625rem;
  top: 0.35rem;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--color-secondary);
  border: 2px solid var(--color-bg);
}

.timeline__year {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--color-accent);
  min-width: 4.5rem;
  flex-shrink: 0;
}

.timeline__event {
  color: var(--color-text);
  opacity: 0.85;
  font-size: 0.95rem;
}

.about-section__sub {
  margin-top: 1.5rem;
}

.about-section__sub-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-accent);
  margin-bottom: 0.5rem;
}

.certification-list {
  color: var(--color-text);
  opacity: 0.85;
  line-height: 1.8;
  padding-left: 1.5rem;
}

.link-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.link-list__item {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  color: var(--color-text);
}

.link-list__label {
  font-weight: 700;
  color: var(--color-accent);
  min-width: 6rem;
  flex-shrink: 0;
}

.link-list a {
  color: var(--color-secondary);
}

.link-list__email {
  background: none;
  border: none;
  padding: 0;
  font: inherit;
  color: var(--color-secondary);
  cursor: pointer;
  text-decoration: underline;
}

@media (max-width: 640px) {
  .about-profile { flex-direction: column; align-items: center; text-align: center; }
}
</style>
