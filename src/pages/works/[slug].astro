---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => !data.draft);
  return works.map(work => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { title, description, date, thumbnail, tags } = work.data;
const { Content } = await render(work);
const formattedDate = date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="page-main">
    <article class="work-article">
      <div class="work-article__hero">
        <Image
          src={thumbnail}
          alt={title}
          width={1200}
          height={630}
          class="work-article__thumb"
        />
      </div>
      <div class="work-article__body">
        <header class="work-article__header">
          <ul class="work-article__tags">
            {tags.map(tag => <li class="work-article__tag">{tag}</li>)}
          </ul>
          <h1 class="work-article__title">{title}</h1>
          <time class="work-article__date" datetime={date.toISOString()}>{formattedDate}</time>
        </header>
        <div class="prose">
          <Content />
        </div>
        <a href="/works" class="back-link">← Works 一覧に戻る</a>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
.page-main { padding-top: 64px; min-height: 100vh; }

.work-article__hero {
  width: 100%;
  max-height: 480px;
  overflow: hidden;
}

.work-article__thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.work-article__body {
  max-width: 800px;
  margin: 0 auto;
  padding: 3rem 2rem;
}

.work-article__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
  list-style: none;
  margin-bottom: 1rem;
}

.work-article__tag {
  font-size: 0.75rem;
  padding: 0.125rem 0.6rem;
  background: rgba(0, 99, 170, 0.4);
  border: 1px solid rgba(104, 206, 214, 0.3);
  border-radius: 100px;
  color: var(--color-secondary);
}

.work-article__title {
  font-size: clamp(1.5rem, 4vw, 2.5rem);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 0.5rem;
}

.work-article__date {
  font-size: 0.85rem;
  color: var(--color-text);
  opacity: 0.5;
}

.prose {
  margin-top: 2rem;
  color: var(--color-text);
  opacity: 0.9;
  line-height: 1.8;
}

.prose :global(h2) { font-size: 1.4rem; font-weight: 700; margin: 2rem 0 0.75rem; color: var(--color-secondary); }
.prose :global(h3) { font-size: 1.1rem; font-weight: 600; margin: 1.5rem 0 0.5rem; }
.prose :global(p)  { margin-bottom: 1rem; }
.prose :global(ul), .prose :global(ol) { padding-left: 1.5rem; margin-bottom: 1rem; }
.prose :global(li) { margin-bottom: 0.25rem; }
.prose :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px; }
.prose :global(a:hover) { opacity: 0.8; }
.prose :global(code) { background: rgba(104,206,214,0.1); border-radius: 4px; padding: 0.1em 0.3em; font-size: 0.9em; }

.back-link {
  display: inline-block;
  margin-top: 3rem;
  color: var(--color-secondary);
  opacity: 0.8;
  font-size: 0.9rem;
  transition: opacity 0.2s;
}

.back-link:hover { opacity: 1; }
</style>
