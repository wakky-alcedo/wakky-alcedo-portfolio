---
import PageLayout from '../../components/layout/PageLayout.astro';
import { getCollection } from 'astro:content';
import SortableWorksGrid from '../../components/works/SortableWorksGrid.astro';

const allWorks = (await getCollection('works', ({ data }) => !data.unpublished));
---

<PageLayout title="Works" description="制作物・プロジェクト一覧" subtitle="制作物・プロジェクト" width="wide">
  <SortableWorksGrid works={allWorks} />
</PageLayout>
