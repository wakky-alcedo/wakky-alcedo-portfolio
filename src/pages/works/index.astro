---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import SortableWorksGrid from '../../components/works/SortableWorksGrid.astro';
import SectionTitle from '../../components/common/SectionTitle.astro';
import BackButton from '../../components/common/BackButton.astro';

const allWorks = (await getCollection('works', ({ data }) => !data.unpublished));
---

<BaseLayout title="Works" description="制作物・プロジェクト一覧">
  <Header />
  <main class="page-main">
    <div class="page-container">
      <BackButton href="/" label="トップへ戻る" />
      <SectionTitle title="Works" subtitle="制作物・プロジェクト" />
      <SortableWorksGrid works={allWorks} />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
.page-main {
  padding-top: 80px;
  min-height: 100vh;
}

.page-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 4rem 2rem;
}
</style>

