---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SectionTitle from '../components/common/SectionTitle.astro';
---

<BaseLayout title="Contact" description="お問い合わせ・連絡先">
  <Header />
  <main class="page-main">
    <div class="page-container">
      <SectionTitle title="Contact" subtitle="お問い合わせ" />

      <p class="contact-intro">お気軽にお声がけください。SNSのDMもお気軽に。</p>

      <ul class="contact-list">
        <li class="contact-item">
          <a href="https://twitter.com/" target="_blank" rel="noopener noreferrer" class="contact-link">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.259 5.626zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <div>
              <span class="contact-link__label">Twitter / X</span>
              <span class="contact-link__hint">@wakky_alcedo</span>
            </div>
          </a>
        </li>
        <li class="contact-item">
          <a href="https://note.com/" target="_blank" rel="noopener noreferrer" class="contact-link">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3 3h18v18H3V3zm2 2v14h14V5H5zm2 3h10v2H7V8zm0 4h10v2H7v-2zm0 4h6v2H7v-2z"/>
            </svg>
            <div>
              <span class="contact-link__label">note</span>
              <span class="contact-link__hint">wakky-alcedo</span>
            </div>
          </a>
        </li>
        <li class="contact-item">
          <button
            class="contact-link contact-link--email"
            id="reveal-email"
            data-email="dGFrdWppLmNvcm90b24udGhhbmtzQGdtYWlsLmNvbQ=="
            aria-label="メールアドレスを表示"
          >
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <div>
              <span class="contact-link__label">Email</span>
              <span class="contact-link__hint" id="email-display">クリックして表示</span>
            </div>
          </button>
        </li>
      </ul>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const btn = document.getElementById('reveal-email') as HTMLButtonElement | null;
  const display = document.getElementById('email-display');
  if (btn && display) {
    btn.addEventListener('click', () => {
      const decoded = atob(btn.dataset.email ?? '');
      display.textContent = decoded;
      btn.setAttribute('aria-label', decoded);
      const a = document.createElement('a');
      a.href = `mailto:${decoded}`;
      a.className = 'contact-link contact-link--email-reveal';
      a.innerHTML = btn.innerHTML;
      (display as HTMLElement).textContent = decoded;
    });
  }
</script>

<style>
.page-main { padding-top: 80px; min-height: 100vh; }
.page-container { max-width: 600px; margin: 0 auto; padding: 4rem 2rem; }

.contact-intro {
  color: var(--color-text);
  opacity: 0.75;
  margin-bottom: 2.5rem;
  line-height: 1.7;
}

.contact-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.contact-link {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.25rem 1.5rem;
  background: rgba(0, 99, 170, 0.1);
  border: 1px solid rgba(104, 206, 214, 0.2);
  border-radius: 12px;
  color: var(--color-text);
  width: 100%;
  text-align: left;
  cursor: pointer;
  font-family: inherit;
  font-size: inherit;
  transition: background 0.2s, border-color 0.2s, transform 0.2s;
}

.contact-link:hover {
  background: rgba(0, 99, 170, 0.2);
  border-color: rgba(104, 206, 214, 0.5);
  transform: translateX(4px);
}

.contact-link__label {
  display: block;
  font-size: 1rem;
  font-weight: 600;
}

.contact-link__hint {
  display: block;
  font-size: 0.8rem;
  opacity: 0.6;
  margin-top: 0.1rem;
}
</style>
