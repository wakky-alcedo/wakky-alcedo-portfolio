---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import BackButton from '../common/BackButton.astro';
import ExternalLink from '../content/ExternalLink.astro';
import TwitterEmbed from '../content/TwitterEmbed.astro';
import NoteEmbed from '../content/NoteEmbed.astro';
import YouTube from '../content/YouTube.astro';
import FlexRow from '../content/FlexRow.astro';
import MarkdownImage from '../content/MarkdownImage.astro';

interface Props {
  entry: CollectionEntry<'works'> | CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, date, thumbnail, tags, unpublished } = entry.data;
const { Content } = await render(entry);
const formattedDate = date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });

// コレクションごとの一覧ページ（タグの配色も Works=シアン / Blog=アクセント で分ける）
// dev のときだけ、記事エディタ（src/dev-editor/）を開くボタンを出す
const editHref = import.meta.env.DEV && entry.filePath?.endsWith('.mdx')
  ? `/_edit?file=${encodeURIComponent(`${entry.collection}/${entry.filePath.split('/').pop()}`)}`
  : undefined;

const listPage = {
  works: { href: '/works', name: 'Works' },
  blog: { href: '/blog', name: 'Blog' },
}[entry.collection];
---

<BaseLayout title={title} description={description} ogImage={thumbnail} article={{ publishedTime: date, tags }}>
  <Header />
  <main class="page-main">
    <article class:list={['article', `article--${entry.collection}`]}>
      {thumbnail && (
        <div class="article__hero">
          <Image src={thumbnail} alt={title} width={1200} height={630} class="article__thumb" />
        </div>
      )}
      <div class="article__body">
        <BackButton href={listPage.href} label={`${listPage.name} 一覧へ戻る`} />
        <header class="article__header">
          <ul class="article__tags">
            {tags.map((tag) => <li class="article__tag">{tag}</li>)}
          </ul>
          {unpublished && <p class="article__unpublished">非公開（dev サーバーでのみ表示）</p>}
          {editHref && <a class="article__edit" href={editHref}>✎ 編集</a>}
          <h1 class="article__title">{title}</h1>
          <time class="article__date" datetime={date.toISOString()}>{formattedDate}</time>
        </header>
        <div class="prose">
          {/* img・YouTube・FlexRow・TwitterEmbed は素の Markdown から変換される（src/lib/remark-embeds.ts） */}
          <Content components={{ a: ExternalLink, img: MarkdownImage, YouTube, FlexRow, TwitterEmbed, NoteEmbed }} />
        </div>
        <a href={listPage.href} class="back-link">← {listPage.name} 一覧に戻る</a>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
.page-main { padding-top: 64px; min-height: 100vh; }

.article__hero {
  width: 100%;
  /* 高さを決めて object-fit で中央を切り出す（下だけが欠けないように） */
  aspect-ratio: 1200 / 630;
  max-height: 480px;
  overflow: hidden;
}

.article__thumb {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.article__body {
  max-width: 800px;
  margin: 0 auto;
  padding: 3rem 2rem;
}

.article__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
  list-style: none;
  margin-bottom: 1rem;
}

.article__tag {
  font-size: 0.75rem;
  padding: 0.125rem 0.6rem;
  border-radius: 100px;
  background: var(--tag-bg);
  border: 1px solid var(--tag-border);
  color: var(--tag-text);
}


.article__unpublished {
  display: inline-block;
  margin-bottom: 0.5rem;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.15rem 0.6rem;
  border: 1px dashed var(--color-accent);
  border-radius: 100px;
  color: var(--color-accent);
}

.article__edit {
  display: inline-block;
  margin: 0 0 0.5rem 0.5rem;
  font-size: 0.75rem;
  padding: 0.15rem 0.6rem;
  border: 1px solid var(--color-accent);
  border-radius: 100px;
  color: var(--color-accent);
}

.article__title {
  font-size: clamp(1.5rem, 4vw, 2.5rem);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 0.5rem;
}

.article__date {
  font-size: 0.85rem;
  color: var(--color-text);
  opacity: 0.5;
}

.prose {
  margin-top: 2rem;
  color: var(--color-text);
  opacity: 0.9;
  line-height: 1.8;
}

.prose :global(h2) { font-size: 1.4rem; font-weight: 700; margin: 2rem 0 0.75rem; color: var(--color-secondary); }
.prose :global(h3) { font-size: 1.1rem; font-weight: 600; margin: 1.5rem 0 0.5rem; }
.prose :global(p)  { margin-bottom: 1rem; }
.prose :global(ul), .prose :global(ol) { padding-left: 1.5rem; margin-bottom: 1rem; }
.prose :global(li) { margin-bottom: 0.25rem; }
.prose :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px; }
.prose :global(a:hover) { opacity: 0.8; }
.prose :global(code) { background: var(--tag-bg); border-radius: 4px; padding: 0.1em 0.3em; font-size: 0.9em; }
/* 表（dev エディタのプレビュー src/dev-editor/EditorPage.astro の .ed-table-preview と同じ見た目） */
.prose :global(table) { border-collapse: collapse; width: 100%; margin-bottom: 1rem; font-size: 0.92rem; line-height: 1.6; overflow-wrap: anywhere; }
.prose :global(th), .prose :global(td) { border: 1px solid var(--line-strong); padding: 0.35rem 0.75rem; vertical-align: top; }
/* 列の寄せ（|:---:| など）を指定していないセルは左寄せ */
.prose :global(th:not([align])), .prose :global(td:not([align])) { text-align: left; }
.prose :global(th) { background: var(--tag-bg); font-weight: 700; }

.back-link {
  display: inline-block;
  margin-top: 3rem;
  color: var(--color-accent);
  opacity: 0.8;
  font-size: 0.9rem;
  transition: opacity 0.2s;
}

.back-link:hover { opacity: 1; }
</style>
