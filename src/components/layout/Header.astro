---
const navItems = [
  { label: 'Works', href: '/works' },
  { label: 'Blog',  href: '/blog' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header__inner">
    <a href="/" class="header__logo">Wakky-Alcedo</a>
    <nav class="header__nav" aria-label="メインナビゲーション">
      <ul class="header__nav-list">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class:list={['header__nav-link', { 'is-active': currentPath.startsWith(item.href) }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button class="header__menu-btn" aria-label="メニューを開く" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-header);
  background: rgba(0, 17, 44, 0.85);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid rgba(104, 206, 214, 0.15);
}

.header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
  height: 64px;
}

.header__logo {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--color-secondary);
  letter-spacing: 0.05em;
}

.header__nav-list {
  display: flex;
  gap: 2rem;
  list-style: none;
}

.header__nav-link {
  font-size: 0.9rem;
  color: var(--color-text);
  opacity: 0.8;
  transition: opacity 0.2s, color 0.2s;
}

.header__nav-link:hover,
.header__nav-link.is-active {
  opacity: 1;
  color: var(--color-secondary);
}

.header__menu-btn {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
}

.header__menu-btn span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--color-text);
  border-radius: 2px;
}

@media (max-width: 640px) {
  .header__nav {
    display: none;
  }
  .header__menu-btn {
    display: flex;
  }
}
</style>
