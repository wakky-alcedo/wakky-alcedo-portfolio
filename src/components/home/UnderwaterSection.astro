---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import WorkCard from '../works/WorkCard.astro';
import BlogCard from '../blog/BlogCard.astro';
import SectionTitle from '../common/SectionTitle.astro';
import FishLayer from './FishLayer.astro';
import profilePicture from '../../assets/images/profile_picture.jpg';

const rawWorks = await getCollection('works', ({ data }) => !data.unpublished);

const worksFeatured = [...rawWorks].sort((a, b) => {
  const d = b.data.featured - a.data.featured;
  return d !== 0 ? d : b.data.date.getTime() - a.data.date.getTime();
});

const worksNewest = [...rawWorks].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allBlog = (await getCollection('blog', ({ data }) => !data.unpublished))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const skillTags = [
  { name: 'STM32', category: '組み込み制御' },
  { name: 'ESP32', category: '組み込み制御' },
  { name: 'Raspberry Pi', category: '組み込み制御' },
  { name: 'ROS2', category: '組み込み制御' },
  { name: 'jw_cad', category: '機械設計等' },
  { name: 'SOLIDWORKS', category: '機械設計等' },
  { name: 'Fusion360', category: '機械設計等' },
  { name: 'Inventor', category: '機械設計等' },
  { name: '3Dプリンタ', category: '機械設計等' },
  { name: 'C/C++', category: 'プログラム言語' },
  { name: 'Python', category: 'プログラム言語' },
  { name: 'YOLO', category: 'その他' },
];
---

<div class="underwater" id="underwater">
  <canvas
    id="caustics-layer"
    class="caustics-layer"
    role="presentation"
    aria-hidden="true"
  ></canvas>
  <FishLayer />

  <!-- Works -->
  <section class="underwater__section" id="works">
    <div class="underwater__container">
      <SectionTitle title="Works" subtitle="制作物・プロジェクト" />
      <div class="sort-toggle" id="home-sort-toggle">
        <button class="sort-btn active" data-sort="featured">Featured</button>
        <button class="sort-btn" data-sort="newest">Newest</button>
      </div>
      <div class="works-grid" id="home-works-featured">
        {worksFeatured.map(work => <WorkCard work={work} />)}
      </div>
      <div class="works-grid hidden" id="home-works-newest">
        {worksNewest.map(work => <WorkCard work={work} />)}
      </div>
      <a href="/works" class="underwater__more-link">すべての作品を見る →</a>
    </div>
  </section>

  <!-- Blog -->
  <section class="underwater__section hscroll" id="blog" data-hscroll>
    <div class="underwater__container hscroll__head">
      <SectionTitle title="Blog" subtitle="活動記録・思考メモ" />
    </div>
    <div class="hscroll__track" data-hscroll-track>
      {allBlog.slice(0, 5).map(post => <BlogCard post={post} />)}
      <a href="/blog" class="hscroll__more">すべての記事を見る →</a>
    </div>
  </section>

  <!-- About -->
  <section class="underwater__section" id="about">
    <div class="underwater__container">
      <SectionTitle title="About" subtitle="自己紹介" />
      <div class="about-preview">
        <Image
          src={profilePicture}
          alt="プロフィール写真"
          width={160}
          height={160}
          class="about-preview__photo"
        />
        <div class="about-preview__text">
          <p>小中，高専，大学と，一貫してものづくりをやってきました。手を動かして何かを作ることと，イベントの企画運営が好きです。発明考案展出展，高専ロボコン，全国ロボコン交流会幹事，商品開発インターン，受託開発アルバイト，画像認識&ロボット制御インターン，文化祭の企画・製作・運営などをしてきました。</p>
          <ul class="about-preview__skills">
            {skillTags.map(tag => (
              <li class="about-preview__skill">
                <span class="about-preview__skill-name">{tag.name}</span>
                <span class="about-preview__skill-cat">{tag.category}</span>
              </li>
            ))}
          </ul>
          <a href="/about" class="underwater__more-link">もっと読む →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="underwater__section" id="contact">
    <div class="underwater__container">
      <SectionTitle title="Contact" subtitle="お問い合わせ" />
      <div class="contact-links">
        <a href="https://twitter.com/" target="_blank" rel="noopener" class="contact-link">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.259 5.626zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          Twitter / X
        </a>
        <a href="https://note.com/" target="_blank" rel="noopener" class="contact-link">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3 3h18v18H3V3zm2 2v14h14V5H5zm2 3h10v2H7V8zm0 4h10v2H7v-2zm0 4h6v2H7v-2z"/>
          </svg>
          note
        </a>
        <span class="contact-email" id="contact-email" data-email="dGFrdWppLmNvcm90b24udGhhbmtzQGdtYWlsLmNvbQ==">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <span id="email-text">メールを表示</span>
        </span>
      </div>
    </div>
  </section>
</div>

<script>
  // Works sort toggle
  const toggle = document.getElementById('home-sort-toggle');
  if (toggle) {
    const featured = document.getElementById('home-works-featured')!;
    const newest = document.getElementById('home-works-newest')!;
    toggle.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        toggle.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        if (btn.dataset.sort === 'featured') {
          featured.classList.remove('hidden');
          newest.classList.add('hidden');
        } else {
          newest.classList.remove('hidden');
          featured.classList.add('hidden');
        }
      });
    });
  }
</script>

<script>
  // メールアドレス難読化
  const emailEl = document.getElementById('contact-email');
  const emailText = document.getElementById('email-text');
  if (emailEl && emailText) {
    emailEl.style.cursor = 'pointer';
    emailEl.addEventListener('click', () => {
      const encoded = emailEl.dataset.email ?? '';
      const decoded = atob(encoded);
      emailText.textContent = decoded;
      const link = document.createElement('a');
      link.href = `mailto:${decoded}`;
      link.textContent = decoded;
      emailText.replaceWith(link);
      emailEl.style.cursor = 'default';
    });
  }
</script>

<style>
.underwater {
  background: var(--color-bg);
  position: relative;
}

.caustics-layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: var(--z-caustics);
  mix-blend-mode: screen;
  will-change: contents;
}

.underwater__section {
  position: relative;
  z-index: var(--z-ui);
  padding: 5rem 0;
  border-bottom: 1px solid rgba(104, 206, 214, 0.1);
}

.underwater__section:last-child {
  border-bottom: none;
}

.underwater__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

/* 横スクロールセクション（GSAPピン固定パターン） */
.hscroll {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 4rem 0;
  overflow: hidden;
}

.hscroll__head {
  flex-shrink: 0;
}

.hscroll__head :global(.section-title) {
  margin-bottom: 1.5rem;
}

.hscroll__track {
  display: flex;
  align-items: stretch;
  gap: 1.25rem;
  padding-left: max(2rem, calc((100vw - 1200px) / 2));
  padding-right: 2rem;
  width: max-content;
  will-change: transform;
}

.hscroll__more {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-width: 200px;
  font-size: 0.95rem;
  color: var(--color-secondary);
  opacity: 0.8;
  transition: opacity 0.2s;
}

.hscroll__more:hover {
  opacity: 1;
}

.sort-toggle {
  display: flex;
  gap: 0.5rem;
  margin-top: 1.5rem;
  margin-bottom: 0;
}

.sort-btn {
  padding: 0.4rem 1.2rem;
  border: 1px solid var(--color-border, rgba(104, 206, 214, 0.3));
  border-radius: 999px;
  background: transparent;
  color: var(--color-text, inherit);
  font-size: 0.875rem;
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
}

.sort-btn.active {
  background: var(--color-secondary);
  color: var(--color-bg);
  border-color: var(--color-secondary);
}

.hidden {
  display: none !important;
}

/* Works タイル表示 */
.works-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
  margin-top: 1.5rem;
}

.underwater__more-link {
  display: inline-block;
  margin-top: 1.5rem;
  font-size: 0.95rem;
  color: var(--color-secondary);
  opacity: 0.8;
  transition: opacity 0.2s;
}

.underwater__more-link:hover {
  opacity: 1;
}

/* About */
.about-preview {
  display: flex;
  gap: 2rem;
  align-items: flex-start;
}

.about-preview__photo {
  border-radius: 50%;
  flex-shrink: 0;
  border: 3px solid var(--color-secondary);
  object-fit: cover;
}

.about-preview__text p {
  color: var(--color-text);
  opacity: 0.85;
  line-height: 1.8;
  margin-bottom: 1rem;
}

.about-preview__skills {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  list-style: none;
  margin-bottom: 1.25rem;
}

.about-preview__skill {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.2rem;
  padding: 0.5rem 0.85rem;
  background: rgba(0, 99, 170, 0.15);
  border: 1px solid rgba(104, 206, 214, 0.2);
  border-radius: 10px;
}

.about-preview__skill-name {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--color-text);
}

.about-preview__skill-cat {
  font-size: 0.65rem;
  color: var(--color-secondary);
  opacity: 0.7;
}

/* Contact */
.contact-links {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
}

.contact-link,
.contact-email {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--color-text);
  opacity: 0.7;
  font-size: 0.95rem;
  transition: opacity 0.2s, color 0.2s;
}

.contact-link:hover,
.contact-email:hover {
  opacity: 1;
  color: var(--color-secondary);
}

@media (max-width: 640px) {
  .about-preview {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
}

/* prefers-reduced-motion: 横スクロールピン演出を行わないため、
   折り返し表示にして全カードへアクセス可能にする */
@media (prefers-reduced-motion: reduce) {
  .hscroll {
    overflow: visible;
  }

  .hscroll__track {
    flex-wrap: wrap;
    width: auto;
  }
}
</style>
