---
import type { CollectionEntry } from 'astro:content';
import EntryCard from '../common/EntryCard.astro';
import CardCollection from '../common/CardCollection.astro';

interface Props {
  works: CollectionEntry<'works'>[];
  /** スマホでの並べ方（CardCollection 参照） */
  mobile: 'grid' | 'row';
  /** 親コンポーネントから余白などを付けるためのクラス */
  class?: string;
}

// rest には親の scoped スタイル用属性（data-astro-cid-*）が入るのでルート要素に渡す
const { works, mobile, class: className, ...rest } = Astro.props;

const byNewest = (a: CollectionEntry<'works'>, b: CollectionEntry<'works'>) =>
  b.data.date.getTime() - a.data.date.getTime();

// Featured: featured の値が大きい順、同値は新しい順
const worksFeatured = [...works].sort((a, b) => b.data.featured - a.data.featured || byNewest(a, b));
const worksNewest = [...works].sort(byNewest);
---

<div class:list={['sortable-works', className]} {...rest}>
  <div class="sort-toggle">
    <button class="sort-btn active" type="button" data-sort="featured">Featured</button>
    <button class="sort-btn" type="button" data-sort="newest">Newest</button>
  </div>
  <CardCollection mobile={mobile} data-sort-panel="featured">
    {worksFeatured.map((work) => <EntryCard entry={work} />)}
  </CardCollection>
  <CardCollection mobile={mobile} data-sort-panel="newest" hidden>
    {worksNewest.map((work) => <EntryCard entry={work} />)}
  </CardCollection>
</div>

<style>
.sort-toggle {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
}

.sort-btn {
  padding: 0.4rem 1.2rem;
  border: 1px solid rgba(var(--color-secondary-rgb), 0.3);
  border-radius: 999px;
  background: transparent;
  color: var(--color-text);
  font-size: 0.875rem;
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
}

.sort-btn.active {
  background: var(--color-secondary);
  color: var(--color-bg);
  border-color: var(--color-secondary);
}
</style>

<script>
  document.querySelectorAll<HTMLElement>('.sortable-works').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('.sort-btn');
    const panels = root.querySelectorAll<HTMLElement>('[data-sort-panel]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.toggle('active', b === btn));
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.sortPanel !== btn.dataset.sort;
        });
      });
    });
  });
</script>
