---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'works'> | CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, thumbnail, tags, wip, unpublished, date } = entry.data;
// unpublished は dev でだけ届く（build では getVisibleEntries で除外される）ので、非公開バッジも dev 専用
const isBlog = entry.collection === 'blog';
const formattedDate = date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<!--
  Works / Blog 共通のカード（トップ・一覧ページ）。上にトップ画像、下にタイトルとタグ。
  タグは控えめな中立色（色はトップ画像に任せる）。Blog は日付も出す。
-->
<a href={`/${entry.collection}/${entry.id}`} class:list={['entry-card', `entry-card--${entry.collection}`]} data-collection={entry.collection}>
  {wip && <span class="entry-card__wip">WIP</span>}
  {unpublished && <span class="entry-card__unpublished">非公開</span>}
  <div class="entry-card__thumb">
    {thumbnail ? (
      <Image src={thumbnail} alt={title} width={400} height={250} class="entry-card__img" />
    ) : (
      <div class="entry-card__img entry-card__img--placeholder" aria-hidden="true"></div>
    )}
    {description && (
      <div class="entry-card__overlay">
        <p class="entry-card__desc">{description}</p>
      </div>
    )}
  </div>
  <div class="entry-card__body">
    {isBlog && <time class="entry-card__date" datetime={date.toISOString()}>{formattedDate}</time>}
    <h3 class="entry-card__title">{title}</h3>
    <ul class="entry-card__tags">
      {tags.map((tag) => <li class="entry-card__tag">{tag}</li>)}
    </ul>
  </div>
</a>

<style>
.entry-card {
  display: block;
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  background: var(--surface-card);
  border: 1px solid var(--line-subtle);
  transition: transform 0.3s, border-color 0.3s;
  min-width: 280px;
  flex-shrink: 0;
}

.entry-card:hover {
  transform: translateY(-4px);
  border-color: var(--line-strong);
}

.entry-card__thumb {
  position: relative;
  overflow: hidden;
  aspect-ratio: 16 / 10;
}

.entry-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s;
}

.entry-card__img--placeholder {
  background: linear-gradient(135deg, rgba(var(--color-primary-rgb), 0.6), rgba(var(--color-secondary-rgb), 0.25));
}

.entry-card:hover .entry-card__img {
  transform: scale(1.05);
}

.entry-card__overlay {
  position: absolute;
  inset: 0;
  background: rgba(var(--color-bg-rgb), 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  opacity: 0;
  transition: opacity 0.3s;
}

.entry-card:hover .entry-card__overlay {
  opacity: 1;
}

.entry-card__desc {
  font-size: 0.85rem;
  color: var(--color-text);
  text-align: center;
  line-height: 1.5;
}

.entry-card__body {
  padding: 0.75rem 1rem;
}

.entry-card__date {
  display: block;
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.5;
  margin-bottom: 0.25rem;
}

.entry-card__title {
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 0.5rem;
}

.entry-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
  list-style: none;
}

.entry-card__tag {
  font-size: 0.7rem;
  padding: 0.125rem 0.5rem;
  border-radius: 100px;
  background: var(--tag-bg);
  border: 1px solid var(--tag-border);
  color: var(--tag-text);
}


.entry-card__wip {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  z-index: 10;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  padding: 0.15rem 0.5rem;
  background: rgba(var(--color-accent-rgb), 0.85);
  color: var(--color-bg);
  border-radius: 100px;
}

.entry-card__unpublished {
  position: absolute;
  top: 0.5rem;
  left: 0.5rem;
  z-index: 10;
  font-size: 0.65rem;
  font-weight: 700;
  padding: 0.15rem 0.5rem;
  background: rgba(var(--color-bg-rgb), 0.85);
  border: 1px dashed var(--color-accent);
  color: var(--color-accent);
  border-radius: 100px;
}
</style>
