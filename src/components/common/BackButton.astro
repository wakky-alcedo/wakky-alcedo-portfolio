---
interface Props {
  href: string;
  label?: string;
}
const { href, label = 'Back' } = Astro.props;
---

<a href={href} class="back-btn" aria-label={label}>
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <path d="M11 4L6 9L11 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  {label}
</a>

<style>
.back-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.875rem;
  color: var(--color-text);
  opacity: 0.6;
  transition: opacity 0.2s, color 0.2s;
  padding: 0.25rem 0;
}

.back-btn:hover {
  opacity: 1;
  color: var(--color-secondary);
}
</style>
