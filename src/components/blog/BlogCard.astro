---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, tags, wip } = post.data;
const formattedDate = date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<a href={`/blog/${post.id}`} class="blog-card">
  <div class="blog-card__inner">
    {wip && <span class="blog-card__wip">WIP</span>}
    <div class="blog-card__meta">
      <time class="blog-card__date" datetime={date.toISOString()}>{formattedDate}</time>
      <ul class="blog-card__tags">
        {tags.map(tag => <li class="blog-card__tag">{tag}</li>)}
      </ul>
    </div>
    <h3 class="blog-card__title">{title}</h3>
    <p class="blog-card__desc">{description}</p>
  </div>
  <span class="blog-card__arrow" aria-hidden="true">→</span>
</a>

<style>
.blog-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  gap: 1rem;
  padding: 1.25rem 1.5rem;
  border-radius: 10px;
  background: rgba(0, 99, 170, 0.08);
  border: 1px solid rgba(104, 206, 214, 0.15);
  transition: background 0.2s, border-color 0.2s, transform 0.2s;
  flex-shrink: 0;
  width: min(85vw, 420px);
}

.blog-card:hover {
  background: rgba(0, 99, 170, 0.18);
  border-color: rgba(104, 206, 214, 0.4);
  transform: translateX(4px);
}

.blog-card__inner {
  flex: 1;
  min-width: 0;
}

.blog-card__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 0.25rem;
}

.blog-card__date {
  font-size: 0.8rem;
  color: var(--color-text);
  opacity: 0.5;
}

.blog-card__tags {
  display: flex;
  gap: 0.375rem;
  list-style: none;
}

.blog-card__tag {
  font-size: 0.7rem;
  padding: 0.1rem 0.4rem;
  background: rgba(255, 161, 0, 0.15);
  border: 1px solid rgba(255, 161, 0, 0.3);
  border-radius: 100px;
  color: var(--color-accent);
}

.blog-card__title {
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 0.25rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.blog-card__desc {
  font-size: 0.85rem;
  color: var(--color-text);
  opacity: 0.65;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.blog-card__wip {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  padding: 0.15rem 0.5rem;
  background: rgba(255, 161, 0, 0.85);
  color: #00112C;
  border-radius: 100px;
}

.blog-card__arrow {
  color: var(--color-secondary);
  font-size: 1.2rem;
  opacity: 0.6;
  transition: opacity 0.2s, transform 0.2s;
  flex-shrink: 0;
}

.blog-card:hover .blog-card__arrow {
  opacity: 1;
  transform: translateX(4px);
}
</style>
