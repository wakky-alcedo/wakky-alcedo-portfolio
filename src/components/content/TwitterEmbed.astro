---
interface Props {
  url: string;
}

const { url } = Astro.props;

let html = '';
let error = false;

try {
  const endpoint = `https://publish.twitter.com/oembed?url=${encodeURIComponent(url)}&omit_script=true&lang=ja&dnt=true`;
  const res = await fetch(endpoint);
  if (res.ok) {
    const data = await res.json();
    html = data.html ?? '';
  } else {
    error = true;
  }
} catch {
  error = true;
}
---

{error ? (
  <a href={url} target="_blank" rel="noopener noreferrer" class="embed-fallback">
    {url}
  </a>
) : (
  <figure class="twitter-embed">
    <Fragment set:html={html} />
  </figure>
)}

<script async src="https://platform.twitter.com/widgets.js"></script>

<style>
.twitter-embed {
  margin: 1.5rem auto;
  display: flex;
  justify-content: center;
}

.twitter-embed :global(.twitter-tweet) {
  margin: 0 !important;
}

.embed-fallback {
  display: block;
  color: var(--color-accent);
  word-break: break-all;
}
</style>
