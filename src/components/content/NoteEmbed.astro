---
interface Props {
  url: string;
}

const { url } = Astro.props;

interface OEmbedData {
  title?: string;
  author_name?: string;
  thumbnail_url?: string;
  url?: string;
}

let data: OEmbedData | null = null;

try {
  const endpoint = `https://note.com/oembed?url=${encodeURIComponent(url)}`;
  const res = await fetch(endpoint);
  if (res.ok) {
    data = await res.json();
  }
} catch {
  // fall through to fallback
}
---

{data ? (
  <a href={url} target="_blank" rel="noopener noreferrer" class="note-card">
    {data.thumbnail_url && (
      <img src={data.thumbnail_url} alt={data.title ?? ''} class="note-card__thumb" loading="lazy" />
    )}
    <div class="note-card__body">
      <p class="note-card__title">{data.title}</p>
      {data.author_name && <p class="note-card__author">by {data.author_name}</p>}
      <span class="note-card__badge">note</span>
    </div>
  </a>
) : (
  <a href={url} target="_blank" rel="noopener noreferrer" class="embed-fallback">
    {url}
  </a>
)}

<style>
.note-card {
  display: flex;
  align-items: stretch;
  gap: 0;
  margin: 1.5rem auto;
  border: 1px solid rgba(104, 206, 214, 0.2);
  border-radius: 10px;
  overflow: hidden;
  background: rgba(0, 99, 170, 0.08);
  text-decoration: none;
  transition: background 0.2s, border-color 0.2s;
  max-width: 560px;
}

.note-card:hover {
  background: rgba(0, 99, 170, 0.15);
  border-color: rgba(104, 206, 214, 0.4);
}

.note-card__thumb {
  width: 140px;
  min-height: 90px;
  object-fit: cover;
  flex-shrink: 0;
}

.note-card__body {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.3rem;
  padding: 0.9rem 1rem;
  min-width: 0;
}

.note-card__title {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.4;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin: 0;
}

.note-card__author {
  font-size: 0.8rem;
  color: var(--color-text);
  opacity: 0.6;
  margin: 0;
}

.note-card__badge {
  font-size: 0.75rem;
  color: var(--color-secondary);
  opacity: 0.8;
  margin-top: auto;
}

.embed-fallback {
  display: block;
  color: var(--color-accent);
  word-break: break-all;
}

@media (max-width: 480px) {
  .note-card__thumb {
    width: 100px;
  }
}
</style>
